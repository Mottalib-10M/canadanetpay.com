---
import Consent from '../components/Consent.astro';
import '../styles/global.css';
import { RESUMES } from '../data/resumes';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import AuthorByline from '../components/ui/AuthorByline.astro';
import { articleSchema as buildArticleSchema , OG_IMAGE, OG_IMAGE_WIDTH, OG_IMAGE_HEIGHT} from '../lib/seo';
import { SITE_URL } from '../data/site-config';

interface Props {
  /**
   * Paragraphe citable (RECETTE §21) : au moins 120 mots, rendus dans le corps
   * et non dans l'en-tete, que check-seo retire comme un ornement.
   */
  resume?: string;
  title: string;
  description: string;
  publishDate: string;
  modifiedDate?: string;
  breadcrumbs: { label: string; href?: string }[];
  lang?: string;
  /**
   * Questions de la page. Elles sont affichees ET declarees en `FAQPage` a
   * partir de cette seule source, de sorte que le balisage ne puisse jamais
   * promettre a Google un texte absent de la page (RECETTE §7).
   */
  faqs?: { question: string; answer: string }[];
}

const { title, description, publishDate, modifiedDate, breadcrumbs, lang = 'en', faqs = [], resume} = Astro.props;
// Le resume se trouve par le chemin quand la page ne le fournit pas : une
// seule table a tenir, pas quarante appels a modifier.
const resumeAffiche = resume ?? RESUMES[Astro.url.pathname]
  ?? RESUMES[Astro.url.pathname.replace(/\/$/, '') + '/'];
// Premier écran (RECETTE §5, règle du 2026-10-11) : le mini-simulateur du sujet passe juste
// sous le titre et la réponse directe ; le résumé se replie (première phrase entière, la suite se
// déplie sans JavaScript, un seul <p> complet dans le HTML) et la ligne d'auteur descend sous le
// simulateur.
const avecSimu = Astro.slots.has('simulateur');
const phrases = resumeAffiche ? resumeAffiche.split(/(?<=[.!?])\s+(?=[A-Z0-9])/) : [];
const resumeTete = phrases.slice(0, 1).join(' ');
const resumeSuite = phrases.slice(1).join(' ');
const plusLabel = lang === 'fr' ? 'Lire la suite' : 'Read more';

const faqPageSchema = faqs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
      })),
    }
  : null;
const canonicalUrl = new URL(Astro.url.pathname, SITE_URL).href;
// Hreflang : les quatre pages qui existent dans les deux langues se declarent
// l'une l'autre (check-anglais, 2026-10-05 : les pages francaises n'avaient
// aucune version anglaise declaree alors qu'elle existe).
const PAIRES: Array<[string, string]> = [
  ['/guides/minimum-wage-canada/', '/fr/guides/salaire-minimum-canada/'],
  ['/guides/average-salary-canada/', '/fr/guides/salaire-moyen-canada/'],
  ['/glossary/', '/fr/glossaire/'],
  ['/methodology/', '/fr/methodologie/'],
  ['/privacy/', '/fr/confidentialite/'],
  ['/terms/', '/fr/conditions/'],
];
const chemin = Astro.url.pathname.replace(/\/?$/, '/');
const paire = PAIRES.find(([en, fr]) => en === chemin || fr === chemin);
const articleSchema = buildArticleSchema(
  title,
  description,
  canonicalUrl,
  publishDate,
  modifiedDate ?? publishDate,
);
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  {paire && <link rel="alternate" hreflang="en" href={new URL(paire[0], SITE_URL).href} />}
  {paire && <link rel="alternate" hreflang="fr" href={new URL(paire[1], SITE_URL).href} />}
  {paire && <link rel="alternate" hreflang="x-default" href={new URL(paire[0], SITE_URL).href} />}

  <meta property="og:type" content="article" />
  <meta property="og:image" content={OG_IMAGE} />
  <meta property="og:image:width" content={OG_IMAGE_WIDTH} />
  <meta property="og:image:height" content={OG_IMAGE_HEIGHT} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={OG_IMAGE} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content="Canada Net Pay" />
  <meta property="og:locale" content={lang === 'fr' ? 'fr_CA' : 'en_CA'} />
  <meta property="article:published_time" content={publishDate} />
  {modifiedDate && <meta property="article:modified_time" content={modifiedDate} />}

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="sitemap" href="/sitemap-index.xml" />

  <script is:inline>
    if (localStorage.getItem('theme') === 'dark' || (!localStorage.getItem('theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      document.documentElement.classList.add('dark');
    }
  </script>

  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <Consent part="head" lang={lang} moreHref="/privacy/" />
</head>
<body class="min-h-screen flex flex-col bg-gray-50 dark:bg-dark-bg text-gray-900 dark:text-gray-100 antialiased" data-clarity-mask="true">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:px-4 focus:py-2 focus:bg-white focus:text-gray-900 focus:rounded focus:shadow-lg focus:outline-none focus:ring-2 focus:ring-blue-500">{lang === 'fr' ? 'Aller au contenu principal' : 'Skip to main content'}</a>
  <Header lang={lang} />

  <main id="main-content" class="flex-1 mx-auto w-full max-w-7xl px-4 py-8 sm:px-6 lg:py-8">
    <Breadcrumbs items={breadcrumbs.map((b) => ({ name: b.label, url: b.href ?? '' }))} />

    <article class="prose prose-lg dark:prose-invert max-w-none mt-4">
      <header class={`not-prose ${avecSimu ? 'mb-3' : 'mb-8'}`}>
        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-gray-900 dark:text-white">{title}</h1>
        <p class={`mt-3 text-gray-600 dark:text-gray-400 ${avecSimu ? 'text-base sm:text-lg' : 'text-lg'}`}>{description}</p>
        {!avecSimu && <AuthorByline publishDate={publishDate} modifiedDate={modifiedDate} />}
      </header>
      {resumeAffiche && (avecSimu ? (
      <p class="not-prose mb-4 text-base leading-relaxed text-gray-700 dark:text-gray-300">
        {resumeTete}{resumeSuite && (<><input type="checkbox" id="resume-suite" class="peer sr-only" aria-label={plusLabel} /><span class="hidden peer-checked:inline">{' '}{resumeSuite}</span>{' '}<label for="resume-suite" class="cursor-pointer whitespace-nowrap font-medium text-brand-600 underline dark:text-brand-400 peer-checked:hidden">{plusLabel}</label></>)}
      </p>
      ) : (
      <p class="mb-8 leading-relaxed text-gray-700 dark:text-gray-300">{resumeAffiche}</p>
      ))}
      {avecSimu && (<><slot name="simulateur" /><div class="not-prose mb-8"><AuthorByline publishDate={publishDate} modifiedDate={modifiedDate} /></div></>)}

      <slot />

      {faqs.length > 0 && (
        <section class="mt-12 border-t border-border pt-8">
          <h2 id="faq">{lang === 'fr' ? 'Questions fréquentes' : 'Frequently asked questions'}</h2>
          <div class="mt-6 space-y-4 not-prose">
            {faqs.map((f) => (
              <details class="rounded-xl border border-border bg-white dark:bg-gray-900">
                <summary class="cursor-pointer px-6 py-4 font-semibold hover:text-primary">
                  {f.question}
                </summary>
                <div class="px-6 pb-4 text-sm leading-relaxed text-text-muted">{f.answer}</div>
              </details>
            ))}
          </div>
        </section>
      )}
      {faqPageSchema && <script type="application/ld+json" set:html={JSON.stringify(faqPageSchema)} />}
    </article>
  </main>

  <Footer />
</body>
</html>
