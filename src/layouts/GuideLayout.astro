---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import AuthorByline from '../components/ui/AuthorByline.astro';
import { articleSchema as buildArticleSchema } from '../lib/seo';
import { SITE_URL } from '../data/site-config';

interface Props {
  title: string;
  description: string;
  publishDate: string;
  modifiedDate?: string;
  breadcrumbs: { label: string; href?: string }[];
  lang?: string;
  /**
   * Questions de la page. Elles sont affichees ET declarees en `FAQPage` a
   * partir de cette seule source, de sorte que le balisage ne puisse jamais
   * promettre a Google un texte absent de la page (RECETTE §7).
   */
  faqs?: { question: string; answer: string }[];
}

const { title, description, publishDate, modifiedDate, breadcrumbs, lang = 'en', faqs = [] } = Astro.props;

const faqPageSchema = faqs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
      })),
    }
  : null;
const canonicalUrl = new URL(Astro.url.pathname, SITE_URL).href;
const articleSchema = buildArticleSchema(
  title,
  description,
  canonicalUrl,
  publishDate,
  modifiedDate ?? publishDate,
);
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />

  <meta property="og:type" content="article" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content="Salary After Tax Canada" />
  <meta property="og:locale" content={lang === 'fr' ? 'fr_CA' : 'en_CA'} />
  <meta property="article:published_time" content={publishDate} />
  {modifiedDate && <meta property="article:modified_time" content={modifiedDate} />}

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="sitemap" href="/sitemap-index.xml" />

  <script is:inline>
    if (localStorage.getItem('theme') === 'dark' || (!localStorage.getItem('theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      document.documentElement.classList.add('dark');
    }
  </script>

  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
</head>
<body class="min-h-screen flex flex-col bg-gray-50 dark:bg-dark-bg text-gray-900 dark:text-gray-100 antialiased">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:px-4 focus:py-2 focus:bg-white focus:text-gray-900 focus:rounded focus:shadow-lg focus:outline-none focus:ring-2 focus:ring-blue-500">{lang === 'fr' ? 'Aller au contenu principal' : 'Skip to main content'}</a>
  <Header lang={lang} />

  <main id="main-content" class="flex-1 mx-auto w-full max-w-4xl px-4 py-8 sm:px-6 lg:py-12">
    <Breadcrumbs items={breadcrumbs} />

    <article class="prose prose-lg dark:prose-invert max-w-none mt-6">
      <header class="not-prose mb-8">
        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-gray-900 dark:text-white">{title}</h1>
        <p class="mt-3 text-lg text-gray-600 dark:text-gray-400">{description}</p>
        <AuthorByline publishDate={publishDate} modifiedDate={modifiedDate} />
      </header>

      <slot />

      {faqs.length > 0 && (
        <section class="mt-12 border-t border-border pt-8">
          <h2 id="faq">{lang === 'fr' ? 'Questions fréquentes' : 'Frequently asked questions'}</h2>
          <div class="mt-6 space-y-4 not-prose">
            {faqs.map((f) => (
              <details class="rounded-xl border border-border bg-white dark:bg-gray-900">
                <summary class="cursor-pointer px-6 py-4 font-semibold hover:text-primary">
                  {f.question}
                </summary>
                <div class="px-6 pb-4 text-sm leading-relaxed text-text-muted">{f.answer}</div>
              </details>
            ))}
          </div>
        </section>
      )}
      {faqPageSchema && <script type="application/ld+json" set:html={JSON.stringify(faqPageSchema)} />}
    </article>
  </main>

  <Footer />
</body>
</html>
