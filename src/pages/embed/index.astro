---
import '../../styles/global.css';
import SalaryCalculator from '../../components/calculators/SalaryCalculator';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Salary Calculator Widget - SalaryAfterTax.ca</title>
    <meta name="robots" content="noindex, nofollow" />
    <style>body { margin: 0; padding: 16px; background: #ffffff; }</style>
  </head>
  <body>
    <div class="max-w-7xl mx-auto">
      <SalaryCalculator client:idle />
      <div class="mt-6 pt-4 border-t border-gray-200 text-center">
        <p class="text-xs text-gray-500">
          Powered by <a href="https://canadanetpay.com" target="_blank" rel="noopener noreferrer" class="text-brand-600 hover:underline">SalaryAfterTax.ca</a>
        </p>
      </div>
    </div>

    <script is:inline>
      if (window.self === window.top) {
        const el = document.getElementById('embed-instructions');
        if (el) el.style.display = 'block';
      }
    </script>

    <div id="embed-instructions" style="display:none" class="max-w-7xl mx-auto mt-10 p-6 bg-gray-50 rounded-2xl border border-gray-200">
      <h2 class="text-xl font-bold text-gray-900 mb-4">Embed this calculator on your site</h2>
      <p class="text-sm text-gray-600 mb-4">Copy the code below and paste it into your HTML page.</p>
      <div class="relative">
        <pre class="bg-gray-900 text-green-400 text-sm p-4 rounded-xl overflow-x-auto"><code id="embed-code">&lt;iframe src="https://canadanetpay.com/embed/" width="100%" height="600" style="border: 1px solid #e5e7eb; border-radius: 12px;" title="Canadian Salary Calculator Widget" loading="lazy"&gt;&lt;/iframe&gt;</code></pre>
        <button id="copy-embed-btn" class="absolute top-3 right-3 px-3 py-1.5 text-xs font-medium bg-gray-700 text-gray-200 rounded-lg hover:bg-gray-600 transition-colors">Copy</button>
      </div>
      <script is:inline>
        document.getElementById('copy-embed-btn')?.addEventListener('click', function() {
          const code = document.getElementById('embed-code')?.textContent || '';
          navigator.clipboard.writeText(code).then(() => {
            this.textContent = 'Copied!';
            setTimeout(() => { this.textContent = 'Copy'; }, 2000);
          });
        });
      </script>
      <div class="mt-6 space-y-3">
        <h3 class="text-sm font-semibold text-gray-700">Customization options</h3>
        <ul class="text-sm text-gray-600 space-y-1 list-disc list-inside">
          <li>Adjust height as needed (minimum recommended: 500px)</li>
          <li>The widget is responsive and adapts to container width</li>
        </ul>
      </div>
      <div class="mt-6 p-4 bg-blue-50 border border-blue-100 rounded-xl">
        <p class="text-sm text-blue-800">
          <strong>Backlink appreciated:</strong> If you embed this widget, please add a link to <a href="https://canadanetpay.com" class="underline">canadanetpay.com</a> on your page. This helps us keep this tool free.
        </p>
      </div>
    </div>
  </body>
</html>
