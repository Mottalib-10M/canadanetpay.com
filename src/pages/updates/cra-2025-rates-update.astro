<GuideLayout
  title="CRA 2025 Tax Rate Updates: What Changed"
  description="Complete breakdown of every CRA tax change for 2025: updated federal brackets, CPP and CPP2 rates, EI premiums, and provincial adjustments for Canadian workers."
  publishDate="2025-01-15"
