---
import GuideLayout from '../../../layouts/GuideLayout.astro';
import { SITE_URL } from '../../../data/site-config';
import { breadcrumbSchema } from '../../../lib/seo';

const title = 'Glossaire fiscal et paie au Canada';
const description = 'Définitions des termes fiscaux et de paie canadiens incluant RPC, AE, REER, CELI et impôts provinciaux. Comprenez clairement toutes vos retenues salariales.';
const canonicalUrl = `${SITE_URL}/fr/glossaire/`;

const breadcrumbItems = [
  { name: 'Accueil', url: `${SITE_URL}/fr/` },
  { name: 'Glossaire', url: canonicalUrl },
];

const terms = [
  { term: 'AE (Assurance-emploi)', definition: 'Programme fédéral qui fournit un soutien financier temporaire aux travailleurs qui perdent leur emploi sans faute de leur part, qui sont malades ou qui prennent soin d\'un nouveau-né ou d\'un enfant adopté. En 2026, le taux de cotisation des employés est de 1,58 % sur les gains assurables jusqu\'à 65 700 $, pour une cotisation annuelle maximale de 1 049,12 $.' },
  { term: 'Abattement fédéral (Québec)', definition: 'Une réduction de 16,5 % appliquée à l\'impôt fédéral de base pour les résidents du Québec. Cet abattement existe parce que le Québec administre son propre régime d\'impôt sur le revenu et perçoit l\'impôt provincial séparément du système fédéral. Il empêche la double imposition des résidents québécois.' },
  { term: 'ARC (Agence du revenu du Canada)', definition: 'L\'agence fédérale responsable de l\'administration des lois fiscales pour le gouvernement du Canada et la plupart des provinces et territoires. L\'ARC perçoit les impôts sur le revenu, la TPS/TVH et administre les programmes de prestations tels que l\'Allocation canadienne pour enfants et le crédit pour la TPS/TVH.' },
  { term: 'Allocation canadienne pour enfants (ACE)', definition: 'Un versement mensuel non imposable destiné aux familles admissibles pour les aider à subvenir aux coûts d\'éducation des enfants de moins de 18 ans. Le montant est calculé en fonction du nombre d\'enfants, de leur âge et du revenu net ajusté de la famille. Les versements sont recalculés chaque juillet.' },
  { term: 'Cotisations sociales', definition: 'Les montants retenus sur le salaire brut d\'un employé avant le versement du salaire net. Au Canada, les retenues obligatoires comprennent l\'impôt fédéral sur le revenu, l\'impôt provincial, les cotisations au RPC ou au RRQ et les cotisations à l\'AE. Des retenues volontaires peuvent inclure les cotisations au REER et les cotisations syndicales.' },
  { term: 'CELI (Compte d\'épargne libre d\'impôt)', definition: 'Un compte d\'épargne enregistré dans lequel les revenus de placement et les retraits sont entièrement libres d\'impôt. Contrairement au REER, les cotisations au CELI ne sont pas déductibles d\'impôt, mais toute croissance et tout retrait sont exonérés. Le plafond de cotisation annuel pour 2026 est de 7 000 $, et les droits inutilisés sont reportés.' },
  { term: 'Crédit d\'impôt', definition: 'Un montant qui réduit directement l\'impôt que vous devez, contrairement à une déduction qui réduit votre revenu imposable. Le Canada offre des crédits remboursables (pouvant donner lieu à un versement) et non remboursables (ne pouvant que réduire l\'impôt à zéro). Les crédits courants incluent le montant personnel de base et le crédit pour la TPS/TVH.' },
  { term: 'Crédit d\'impôt non remboursable', definition: 'Un crédit qui réduit le montant d\'impôt à payer mais ne peut pas générer de remboursement s\'il excède l\'impôt dû. Le montant personnel de base est le crédit non remboursable le plus courant au Canada. D\'autres exemples incluent le crédit pour cotisations au RPC/RRQ, le crédit pour cotisations à l\'AE et le montant canadien pour emploi.' },
  { term: 'Crédit pour la TPS/TVH', definition: 'Un versement trimestriel non imposable de l\'ARC qui aide les particuliers et les familles à revenu faible ou modeste à compenser la taxe sur les produits et services (TPS) ou la taxe de vente harmonisée (TVH) payée. L\'admissibilité et le montant sont déterminés automatiquement lors de la production de la déclaration de revenus annuelle.' },
  { term: 'Déduction fiscale', definition: 'Une dépense ou un montant qui réduit votre revenu imposable avant le calcul de l\'impôt. Les déductions courantes comprennent les cotisations au REER, les cotisations syndicales, les frais de garde d\'enfants et les frais de déménagement. Les déductions réduisent votre revenu imposable, ce qui diminue le montant d\'impôt dû à votre taux marginal.' },
  { term: 'Heures supplémentaires', definition: 'La rémunération additionnelle versée pour les heures travaillées au-delà de la semaine de travail normale, généralement fixée à 40 ou 44 heures selon la province. La plupart des juridictions exigent que les heures supplémentaires soient payées à 1,5 fois le taux horaire normal. Certaines provinces ont des seuils et des taux différents.' },
  { term: 'Impôt fédéral', definition: 'L\'impôt sur le revenu prélevé par le gouvernement du Canada sur le revenu imposable des particuliers. Les taux d\'impôt fédéral en 2026 sont progressifs, commençant à 15 % sur les premiers 57 375 $ de revenu imposable et augmentant à travers cinq paliers jusqu\'à 33 % sur les revenus supérieurs à 220 000 $.' },
  { term: 'Impôt provincial', definition: 'L\'impôt sur le revenu prélevé par chaque province et territoire sur le revenu imposable de ses résidents. Chaque province fixe ses propres paliers et taux d\'imposition, qui s\'ajoutent à l\'impôt fédéral. Les taux d\'impôt provincial varient considérablement à travers le Canada.' },
  { term: 'Impôt sur le revenu', definition: 'Un impôt prélevé sur le revenu imposable des particuliers par les gouvernements fédéral et provinciaux/territoriaux. Le Canada utilise un système progressif dans lequel les tranches supérieures de revenu sont imposées à des taux plus élevés. L\'impôt total sur le revenu est le montant combiné de l\'impôt fédéral et provincial après crédits et déductions.' },
  { term: 'Montant personnel de base (MPB)', definition: 'Un crédit d\'impôt non remboursable que chaque résident canadien peut demander, réduisant le montant d\'impôt fédéral sur le revenu à payer. Pour 2026, le MPB fédéral est de 16 129 $. Chaque province a également son propre MPB qui réduit l\'impôt provincial. Le MPB garantit que les personnes gagnant en dessous de ce seuil ne paient aucun impôt.' },
  { term: 'Palier d\'imposition', definition: 'Une fourchette de revenus imposée à un taux spécifique dans le système fiscal progressif du Canada. Seul le revenu situé dans chaque palier est imposé au taux de ce palier, et non la totalité de votre revenu. Par exemple, en 2026, le premier palier fédéral impose les revenus jusqu\'à 57 375 $ à 15 %, et le palier suivant impose les revenus de 57 375 $ à 114 750 $ à 20,5 %.' },
  { term: 'Période de paie', definition: 'Le calendrier récurrent selon lequel les employés sont rémunérés. Les périodes de paie courantes au Canada sont hebdomadaire (52 périodes par an), bihebdomadaire (26), bimensuelle (24) et mensuelle (12). La période de paie détermine la façon dont les retenues sont calculées et prélevées sur chaque chèque de paie.' },
  { term: 'Prime (impôt sur la prime)', definition: 'Lorsqu\'un employeur verse une prime, celle-ci est souvent imposée à un taux de retenue plus élevé car le système de paie suppose que vous gagnez ce montant à chaque période de paie. Votre taux d\'imposition réel en fin d\'année dépend de votre revenu annuel total. Utilisez notre <a href="/">calculateur de salaire</a> pour estimer le montant net.' },
  { term: 'PSV (Pension de la Sécurité de la vieillesse)', definition: 'Un versement mensuel de pension offert à la plupart des Canadiens âgés de 65 ans et plus qui remplissent les conditions de résidence. Contrairement au RPC, la PSV est financée par les recettes fiscales générales et ne nécessite pas de cotisations d\'emploi. Les aînés à revenu élevé peuvent voir leur PSV réduite par la récupération de la PSV.' },
  { term: 'RQAP (Régime québécois d\'assurance parentale)', definition: 'Un programme spécifique au Québec qui verse des prestations de remplacement du revenu aux travailleurs en congé de maternité, de paternité, d\'adoption ou parental. En 2026, le taux de cotisation des employés est de 0,494 % des gains assurables. Le RQAP remplace les prestations de maternité et parentales que les autres provinces reçoivent par l\'AE.' },
  { term: 'REER (Régime enregistré d\'épargne-retraite)', definition: 'Un compte d\'épargne à imposition différée conçu pour aider les Canadiens à épargner pour la retraite. Les cotisations sont déductibles d\'impôt, réduisant votre revenu imposable pour l\'année. La croissance des placements dans le REER est à l\'abri de l\'impôt jusqu\'au retrait. Le plafond de cotisation annuel est de 18 % du revenu gagné, jusqu\'à un maximum fixé chaque année.' },
  { term: 'Retenue d\'impôt', definition: 'Le montant d\'impôt sur le revenu que votre employeur déduit de chaque chèque de paie et remet à l\'ARC en votre nom. La retenue est calculée en fonction de votre revenu annuel estimé, des crédits d\'impôt réclamés sur votre formulaire TD1 et de votre province de résidence. En fin d\'année, vous réconciliez les retenues avec votre obligation fiscale réelle.' },
  { term: 'Revenu imposable', definition: 'La portion de votre revenu total qui est assujettie à l\'impôt sur le revenu après application de toutes les déductions admissibles. Le revenu imposable est calculé en prenant votre revenu total et en soustrayant les déductions admissibles telles que les cotisations au REER, les cotisations syndicales et autres montants permis.' },
  { term: 'RPC (Régime de pensions du Canada)', definition: 'Un programme d\'assurance sociale contributif obligatoire qui fournit des prestations de retraite, d\'invalidité et de survivant. En 2026, les employés cotisent 5,95 % des gains ouvrant droit à pension entre 3 500 $ et 71 300 $, jusqu\'à un maximum de 4 034,10 $ par année. Les employeurs égalent cette cotisation. Consultez notre <a href="/guides/cpp-explained/">guide du RPC</a>.' },
  { term: 'RPC2 (Deuxième cotisation supplémentaire au RPC)', definition: 'Introduite en 2024, la RPC2 est une deuxième cotisation supplémentaire qui s\'applique aux gains supérieurs au premier plafond (71 300 $) jusqu\'à un deuxième plafond de 79 400 $. Le taux de la RPC2 est de 4 % pour les employés et les employeurs, avec une cotisation annuelle maximale de 324 $. Cela améliore les futures prestations de retraite du RPC.' },
  { term: 'RRQ (Régime de rentes du Québec)', definition: 'L\'équivalent québécois du RPC, fournissant des pensions de retraite, d\'invalidité et de survivant aux travailleurs du Québec. Le taux de cotisation des employés en 2026 est de 6,40 % sur les gains ouvrant droit à pension entre 3 500 $ et 71 300 $, pour une cotisation maximale de 4 341,80 $. Le RRQ est administré par Retraite Québec.' },
  { term: 'Salaire', definition: 'Un montant annuel fixe de rémunération versé à un employé, généralement divisé en versements égaux à chaque période de paie. Contrairement au salaire horaire, les employés salariés reçoivent généralement le même salaire brut indépendamment des heures travaillées. Utilisez notre <a href="/">calculateur de salaire</a> pour voir votre salaire net après toutes les déductions.' },
  { term: 'Salaire brut', definition: 'Le montant total de la rémunération gagnée avant toute retenue. Le salaire brut comprend le salaire de base, les heures supplémentaires, les primes, les commissions et autres avantages imposables. C\'est le point de départ pour calculer toutes les retenues sur la paie et arriver à votre <a href="/">salaire net</a>.' },
  { term: 'Salaire net', definition: 'Le montant d\'argent qu\'un employé reçoit après que toutes les retenues obligatoires et volontaires ont été soustraites du salaire brut. C\'est le montant réel déposé dans votre compte bancaire à chaque période de paie. Utilisez notre <a href="/">calculateur de salaire</a> pour estimer votre salaire net dans toute province canadienne.' },
  { term: 'Situation de famille', definition: 'La classification qui détermine les crédits d\'impôt et déductions que vous pouvez réclamer dans votre déclaration de revenus. Au Canada, la situation de famille est généralement basée sur l\'état matrimonial (célibataire, marié ou conjoint de fait) et si vous avez des personnes à charge. Contrairement à certains pays, les couples mariés au Canada produisent des déclarations séparées.' },
  { term: 'T4 (État de la rémunération payée)', definition: 'Un feuillet fiscal officiel émis par les employeurs aux employés avant la fin de février de chaque année. Le T4 indique le revenu d\'emploi total, l\'impôt sur le revenu retenu, les cotisations au RPC et à l\'AE, et les autres avantages imposables pour l\'année civile précédente. Il est requis pour produire votre déclaration de revenus annuelle.' },
  { term: 'Taux d\'imposition effectif', definition: 'Le taux moyen auquel votre revenu total est imposé, calculé en divisant le total de l\'impôt payé par le revenu brut total. En raison du système fiscal progressif du Canada, votre taux effectif est toujours inférieur à votre taux marginal. Il offre une image plus précise de votre charge fiscale globale.' },
  { term: 'Taux d\'imposition marginal', definition: 'Le taux d\'imposition appliqué au dernier dollar de votre revenu imposable. Dans le système progressif canadien, votre taux marginal augmente à mesure que votre revenu entre dans des paliers d\'imposition plus élevés. Comprendre votre taux marginal aide à prendre des décisions financières comme les cotisations au REER.' },
  { term: 'Taux horaire', definition: 'Le montant de rémunération qu\'un employé reçoit par heure de travail. Pour convertir un salaire annuel en taux horaire, divisez le salaire par le nombre d\'heures de travail par année (généralement 2 080 pour un emploi à temps plein). Utilisez notre <a href="/">calculateur de salaire</a> pour convertir entre les fréquences de paie.' },
  { term: 'Travail autonome', definition: 'Revenu gagné par des particuliers qui travaillent pour eux-mêmes plutôt que pour un employeur. Les travailleurs autonomes canadiens doivent payer les parts de l\'employé et de l\'employeur du RPC (un taux combiné de 11,90 % en 2026). Ils ne sont pas tenus de payer les cotisations d\'AE mais peuvent choisir d\'y adhérer pour des prestations spéciales.' },
];

const letters = [...new Set(terms.map(t => t.term[0].toUpperCase()))].sort();
const termsByLetter = letters.map(letter => ({
  letter,
  items: terms.filter(t => t.term[0].toUpperCase() === letter),
}));

const definedTermSetSchema = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  name: 'Glossaire fiscal et paie au Canada',
  description,
  inLanguage: 'fr',
  url: canonicalUrl,
  definedTerm: terms.map(t => ({
    '@type': 'DefinedTerm',
    name: t.term,
    description: t.definition.replace(/<[^>]*>/g, ''),
  })),
};
---

<GuideLayout
  title={title}
  description={description}
  publishDate="2025-01-15"
  breadcrumbs={[{ label: 'Accueil', href: '/fr/' }, { label: 'Glossaire' }]}
  lang="fr"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema(breadcrumbItems))} />
  <script type="application/ld+json" set:html={JSON.stringify(definedTermSetSchema)} />

  <p>
    Ce glossaire couvre les termes les plus importants de la paie et de la fiscalité au Canada. Que vous lisiez
    votre relevé de paie pour la première fois ou que vous compariez des offres d'emploi entre les provinces,
    ces définitions vous aideront à comprendre chaque poste et chaque retenue.
  </p>

  <nav aria-label="Navigation alphabétique" class="not-prose my-8">
    <ul class="flex flex-wrap gap-2">
      {letters.map(letter => (
        <li>
          <a
            href={`#letter-${letter}`}
            class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-gray-200 text-sm font-semibold text-brand-600 hover:bg-brand-50 dark:border-gray-700 dark:text-brand-400 dark:hover:bg-brand-900/20 transition-colors"
          >
            {letter}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  {termsByLetter.map(({ letter, items }) => (
    <section id={`letter-${letter}`} class="scroll-mt-24">
      <h2 class="text-2xl font-bold border-b border-gray-200 dark:border-gray-700 pb-2">{letter}</h2>
      <dl class="mt-4 space-y-6">
        {items.map(item => (
          <div>
            <dt class="text-lg font-semibold text-gray-900 dark:text-white">{item.term}</dt>
            <dd class="mt-1 text-gray-600 dark:text-gray-400 leading-relaxed" set:html={item.definition} />
          </div>
        ))}
      </dl>
    </section>
  ))}

  <div class="not-prose mt-12 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800/50 p-6">
    <h2 class="text-lg font-bold text-gray-900 dark:text-white">Calculateurs connexes</h2>
    <ul class="mt-3 grid gap-2 sm:grid-cols-2 text-sm">
      <li><a href="/fr/" class="text-brand-600 hover:underline dark:text-brand-400">Calculateur de salaire net</a></li>
      <li><a href="/income-tax-calculator/" class="text-brand-600 hover:underline dark:text-brand-400">Calculateur d'impôt sur le revenu</a></li>
      <li><a href="/cpp-calculator/" class="text-brand-600 hover:underline dark:text-brand-400">Calculateur de RPC</a></li>
      <li><a href="/ei-calculator/" class="text-brand-600 hover:underline dark:text-brand-400">Calculateur d'AE</a></li>
      <li><a href="/bonus-tax-calculator/" class="text-brand-600 hover:underline dark:text-brand-400">Calculateur d'impôt sur les primes</a></li>
      <li><a href="/net-to-gross/" class="text-brand-600 hover:underline dark:text-brand-400">Calculateur net vers brut</a></li>
      <li><a href="/employer-cost-calculator/" class="text-brand-600 hover:underline dark:text-brand-400">Calculateur du coût employeur</a></li>
      <li><a href="/hourly-to-salary/" class="text-brand-600 hover:underline dark:text-brand-400">Calculateur horaire vers salaire</a></li>
    </ul>
  </div>
</GuideLayout>
