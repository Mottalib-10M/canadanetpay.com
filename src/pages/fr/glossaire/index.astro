---
import GuideLayout from '../../../layouts/GuideLayout.astro';
import { SITE_URL } from '../../../data/site-config';
import { breadcrumbSchema } from '../../../lib/seo';

const title = 'Glossaire fiscal et paie au Canada';
const description = 'Definitions des termes fiscaux et de paie canadiens incluant RPC, AE, REER, CELI et impots provinciaux. Comprenez clairement toutes vos retenues salariales.';
const canonicalUrl = `${SITE_URL}/fr/glossaire/`;

const breadcrumbItems = [
  { name: 'Accueil', url: `${SITE_URL}/fr/` },
  { name: 'Glossaire', url: canonicalUrl },
];

const terms = [
  { term: 'AE (Assurance-emploi)', definition: 'Programme federal qui fournit un soutien financier temporaire aux travailleurs qui perdent leur emploi sans faute de leur part, qui sont malades ou qui prennent soin d\'un nouveau-ne ou d\'un enfant adopte. En 2025, le taux de cotisation des employes est de 1,58 % sur les gains assurables jusqu\'a 65 700 $, pour une cotisation annuelle maximale de 1 049,12 $.' },
  { term: 'Abattement federal (Quebec)', definition: 'Une reduction de 16,5 % appliquee a l\'impot federal de base pour les residents du Quebec. Cet abattement existe parce que le Quebec administre son propre regime d\'impot sur le revenu et percoit l\'impot provincial separement du systeme federal. Il empeche la double imposition des residents quebecois.' },
  { term: 'ARC (Agence du revenu du Canada)', definition: 'L\'agence federale responsable de l\'administration des lois fiscales pour le gouvernement du Canada et la plupart des provinces et territoires. L\'ARC percoit les impots sur le revenu, la TPS/TVH et administre les programmes de prestations tels que l\'Allocation canadienne pour enfants et le credit pour la TPS/TVH.' },
  { term: 'Allocation canadienne pour enfants (ACE)', definition: 'Un versement mensuel non imposable destine aux familles admissibles pour les aider a subvenir aux couts d\'education des enfants de moins de 18 ans. Le montant est calcule en fonction du nombre d\'enfants, de leur age et du revenu net ajuste de la famille. Les versements sont recalcules chaque juillet.' },
  { term: 'Cotisations sociales', definition: 'Les montants retenus sur le salaire brut d\'un employe avant le versement du salaire net. Au Canada, les retenues obligatoires comprennent l\'impot federal sur le revenu, l\'impot provincial, les cotisations au RPC ou au RRQ et les cotisations a l\'AE. Des retenues volontaires peuvent inclure les cotisations au REER et les cotisations syndicales.' },
  { term: 'CELI (Compte d\'epargne libre d\'impot)', definition: 'Un compte d\'epargne enregistre dans lequel les revenus de placement et les retraits sont entierement libres d\'impot. Contrairement au REER, les cotisations au CELI ne sont pas deductibles d\'impot, mais toute croissance et tout retrait sont exoneres. Le plafond de cotisation annuel pour 2025 est de 7 000 $, et les droits inutilises sont reportes.' },
  { term: 'Credit d\'impot', definition: 'Un montant qui reduit directement l\'impot que vous devez, contrairement a une deduction qui reduit votre revenu imposable. Le Canada offre des credits remboursables (pouvant donner lieu a un versement) et non remboursables (ne pouvant que reduire l\'impot a zero). Les credits courants incluent le montant personnel de base et le credit pour la TPS/TVH.' },
  { term: 'Credit d\'impot non remboursable', definition: 'Un credit qui reduit le montant d\'impot a payer mais ne peut pas generer de remboursement s\'il excede l\'impot du. Le montant personnel de base est le credit non remboursable le plus courant au Canada. D\'autres exemples incluent le credit pour cotisations au RPC/RRQ, le credit pour cotisations a l\'AE et le montant canadien pour emploi.' },
  { term: 'Credit pour la TPS/TVH', definition: 'Un versement trimestriel non imposable de l\'ARC qui aide les particuliers et les familles a revenu faible ou modeste a compenser la taxe sur les produits et services (TPS) ou la taxe de vente harmonisee (TVH) payee. L\'admissibilite et le montant sont determines automatiquement lors de la production de la declaration de revenus annuelle.' },
  { term: 'Deduction fiscale', definition: 'Une depense ou un montant qui reduit votre revenu imposable avant le calcul de l\'impot. Les deductions courantes comprennent les cotisations au REER, les cotisations syndicales, les frais de garde d\'enfants et les frais de demenagement. Les deductions reduisent votre revenu imposable, ce qui diminue le montant d\'impot du a votre taux marginal.' },
  { term: 'Heures supplementaires', definition: 'La remuneration additionnelle versee pour les heures travaillees au-dela de la semaine de travail normale, generalement fixee a 40 ou 44 heures selon la province. La plupart des juridictions exigent que les heures supplementaires soient payees a 1,5 fois le taux horaire normal. Certaines provinces ont des seuils et des taux differents.' },
  { term: 'Impot federal', definition: 'L\'impot sur le revenu preleve par le gouvernement du Canada sur le revenu imposable des particuliers. Les taux d\'impot federal en 2025 sont progressifs, commencant a 15 % sur les premiers 57 375 $ de revenu imposable et augmentant a travers cinq paliers jusqu\'a 33 % sur les revenus superieurs a 220 000 $.' },
  { term: 'Impot provincial', definition: 'L\'impot sur le revenu preleve par chaque province et territoire sur le revenu imposable de ses residents. Chaque province fixe ses propres paliers et taux d\'imposition, qui s\'ajoutent a l\'impot federal. Les taux d\'impot provincial varient considerablement a travers le Canada.' },
  { term: 'Impot sur le revenu', definition: 'Un impot preleve sur le revenu imposable des particuliers par les gouvernements federal et provinciaux/territoriaux. Le Canada utilise un systeme progressif dans lequel les tranches superieures de revenu sont imposees a des taux plus eleves. L\'impot total sur le revenu est le montant combine de l\'impot federal et provincial apres credits et deductions.' },
  { term: 'Montant personnel de base (MPB)', definition: 'Un credit d\'impot non remboursable que chaque resident canadien peut demander, reduisant le montant d\'impot federal sur le revenu a payer. Pour 2025, le MPB federal est de 16 129 $. Chaque province a egalement son propre MPB qui reduit l\'impot provincial. Le MPB garantit que les personnes gagnant en dessous de ce seuil ne paient aucun impot.' },
  { term: 'Palier d\'imposition', definition: 'Une fourchette de revenus imposee a un taux specifique dans le systeme fiscal progressif du Canada. Seul le revenu situe dans chaque palier est impose au taux de ce palier, et non la totalite de votre revenu. Par exemple, en 2025, le premier palier federal impose les revenus jusqu\'a 57 375 $ a 15 %, et le palier suivant impose les revenus de 57 375 $ a 114 750 $ a 20,5 %.' },
  { term: 'Periode de paie', definition: 'Le calendrier recurrent selon lequel les employes sont remuneres. Les periodes de paie courantes au Canada sont hebdomadaire (52 periodes par an), bihebdomadaire (26), bimensuelle (24) et mensuelle (12). La periode de paie determine la facon dont les retenues sont calculees et prelevees sur chaque cheque de paie.' },
  { term: 'Prime (impot sur la prime)', definition: 'Lorsqu\'un employeur verse une prime, celle-ci est souvent imposee a un taux de retenue plus eleve car le systeme de paie suppose que vous gagnez ce montant a chaque periode de paie. Votre taux d\'imposition reel en fin d\'annee depend de votre revenu annuel total. Utilisez notre <a href="/">calculateur de salaire</a> pour estimer le montant net.' },
  { term: 'PSV (Pension de la Securite de la vieillesse)', definition: 'Un versement mensuel de pension offert a la plupart des Canadiens ages de 65 ans et plus qui remplissent les conditions de residence. Contrairement au RPC, la PSV est financee par les recettes fiscales generales et ne necessite pas de cotisations d\'emploi. Les aines a revenu eleve peuvent voir leur PSV reduite par la recuperation de la PSV.' },
  { term: 'RQAP (Regime quebecois d\'assurance parentale)', definition: 'Un programme specifique au Quebec qui verse des prestations de remplacement du revenu aux travailleurs en conge de maternite, de paternite, d\'adoption ou parental. En 2025, le taux de cotisation des employes est de 0,494 % des gains assurables. Le RQAP remplace les prestations de maternite et parentales que les autres provinces recoivent par l\'AE.' },
  { term: 'REER (Regime enregistre d\'epargne-retraite)', definition: 'Un compte d\'epargne a imposition differee concu pour aider les Canadiens a epargner pour la retraite. Les cotisations sont deductibles d\'impot, reduisant votre revenu imposable pour l\'annee. La croissance des placements dans le REER est a l\'abri de l\'impot jusqu\'au retrait. Le plafond de cotisation annuel est de 18 % du revenu gagne, jusqu\'a un maximum fixe chaque annee.' },
  { term: 'Retenue d\'impot', definition: 'Le montant d\'impot sur le revenu que votre employeur deduit de chaque cheque de paie et remet a l\'ARC en votre nom. La retenue est calculee en fonction de votre revenu annuel estime, des credits d\'impot reclames sur votre formulaire TD1 et de votre province de residence. En fin d\'annee, vous reconciliez les retenues avec votre obligation fiscale reelle.' },
  { term: 'Revenu imposable', definition: 'La portion de votre revenu total qui est assujettie a l\'impot sur le revenu apres application de toutes les deductions admissibles. Le revenu imposable est calcule en prenant votre revenu total et en soustrayant les deductions admissibles telles que les cotisations au REER, les cotisations syndicales et autres montants permis.' },
  { term: 'RPC (Regime de pensions du Canada)', definition: 'Un programme d\'assurance sociale contributif obligatoire qui fournit des prestations de retraite, d\'invalidite et de survivant. En 2025, les employes cotisent 5,95 % des gains ouvrant droit a pension entre 3 500 $ et 71 300 $, jusqu\'a un maximum de 4 034,10 $ par annee. Les employeurs egalent cette cotisation. Consultez notre <a href="/guides/cpp-explained/">guide du RPC</a>.' },
  { term: 'RPC2 (Deuxieme cotisation supplementaire au RPC)', definition: 'Introduite en 2024, la RPC2 est une deuxieme cotisation supplementaire qui s\'applique aux gains superieurs au premier plafond (71 300 $) jusqu\'a un deuxieme plafond de 79 400 $. Le taux de la RPC2 est de 4 % pour les employes et les employeurs, avec une cotisation annuelle maximale de 324 $. Cela ameliore les futures prestations de retraite du RPC.' },
  { term: 'RRQ (Regime de rentes du Quebec)', definition: 'L\'equivalent quebecois du RPC, fournissant des pensions de retraite, d\'invalidite et de survivant aux travailleurs du Quebec. Le taux de cotisation des employes en 2025 est de 6,40 % sur les gains ouvrant droit a pension entre 3 500 $ et 71 300 $, pour une cotisation maximale de 4 341,80 $. Le RRQ est administre par Retraite Quebec.' },
  { term: 'Salaire', definition: 'Un montant annuel fixe de remuneration verse a un employe, generalement divise en versements egaux a chaque periode de paie. Contrairement au salaire horaire, les employes salaries recoivent generalement le meme salaire brut independamment des heures travaillees. Utilisez notre <a href="/">calculateur de salaire</a> pour voir votre salaire net apres toutes les deductions.' },
  { term: 'Salaire brut', definition: 'Le montant total de la remuneration gagnee avant toute retenue. Le salaire brut comprend le salaire de base, les heures supplementaires, les primes, les commissions et autres avantages imposables. C\'est le point de depart pour calculer toutes les retenues sur la paie et arriver a votre <a href="/">salaire net</a>.' },
  { term: 'Salaire net', definition: 'Le montant d\'argent qu\'un employe recoit apres que toutes les retenues obligatoires et volontaires ont ete soustraites du salaire brut. C\'est le montant reel depose dans votre compte bancaire a chaque periode de paie. Utilisez notre <a href="/">calculateur de salaire</a> pour estimer votre salaire net dans toute province canadienne.' },
  { term: 'Situation de famille', definition: 'La classification qui determine les credits d\'impot et deductions que vous pouvez reclamer dans votre declaration de revenus. Au Canada, la situation de famille est generalement basee sur l\'etat matrimonial (celibataire, marie ou conjoint de fait) et si vous avez des personnes a charge. Contrairement a certains pays, les couples maries au Canada produisent des declarations separees.' },
  { term: 'T4 (Etat de la remuneration payee)', definition: 'Un feuillet fiscal officiel emis par les employeurs aux employes avant la fin de fevrier de chaque annee. Le T4 indique le revenu d\'emploi total, l\'impot sur le revenu retenu, les cotisations au RPC et a l\'AE, et les autres avantages imposables pour l\'annee civile precedente. Il est requis pour produire votre declaration de revenus annuelle.' },
  { term: 'Taux d\'imposition effectif', definition: 'Le taux moyen auquel votre revenu total est impose, calcule en divisant le total de l\'impot paye par le revenu brut total. En raison du systeme fiscal progressif du Canada, votre taux effectif est toujours inferieur a votre taux marginal. Il offre une image plus precise de votre charge fiscale globale.' },
  { term: 'Taux d\'imposition marginal', definition: 'Le taux d\'imposition applique au dernier dollar de votre revenu imposable. Dans le systeme progressif canadien, votre taux marginal augmente a mesure que votre revenu entre dans des paliers d\'imposition plus eleves. Comprendre votre taux marginal aide a prendre des decisions financieres comme les cotisations au REER.' },
  { term: 'Taux horaire', definition: 'Le montant de remuneration qu\'un employe recoit par heure de travail. Pour convertir un salaire annuel en taux horaire, divisez le salaire par le nombre d\'heures de travail par annee (generalement 2 080 pour un emploi a temps plein). Utilisez notre <a href="/">calculateur de salaire</a> pour convertir entre les frequences de paie.' },
  { term: 'Travail autonome', definition: 'Revenu gagne par des particuliers qui travaillent pour eux-memes plutot que pour un employeur. Les travailleurs autonomes canadiens doivent payer les parts de l\'employe et de l\'employeur du RPC (un taux combine de 11,90 % en 2025). Ils ne sont pas tenus de payer les cotisations d\'AE mais peuvent choisir d\'y adherer pour des prestations speciales.' },
];

const letters = [...new Set(terms.map(t => t.term[0].toUpperCase()))].sort();
const termsByLetter = letters.map(letter => ({
  letter,
  items: terms.filter(t => t.term[0].toUpperCase() === letter),
}));

const definedTermSetSchema = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  name: 'Glossaire fiscal et paie au Canada',
  description,
  inLanguage: 'fr',
  url: canonicalUrl,
  definedTerm: terms.map(t => ({
    '@type': 'DefinedTerm',
    name: t.term,
    description: t.definition.replace(/<[^>]*>/g, ''),
  })),
};
---

<GuideLayout
  title={title}
  description={description}
  publishDate="2025-01-15"
  breadcrumbs={[{ label: 'Accueil', href: '/fr/' }, { label: 'Glossaire' }]}
  lang="fr"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema(breadcrumbItems))} />
  <script type="application/ld+json" set:html={JSON.stringify(definedTermSetSchema)} />

  <p>
    Ce glossaire couvre les termes les plus importants de la paie et de la fiscalite au Canada. Que vous lisiez
    votre releve de paie pour la premiere fois ou que vous compariez des offres d'emploi entre les provinces,
    ces definitions vous aideront a comprendre chaque poste et chaque retenue.
  </p>

  <nav aria-label="Navigation alphabetique" class="not-prose my-8">
    <ul class="flex flex-wrap gap-2">
      {letters.map(letter => (
        <li>
          <a
            href={`#letter-${letter}`}
            class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-gray-200 text-sm font-semibold text-brand-600 hover:bg-brand-50 dark:border-gray-700 dark:text-brand-400 dark:hover:bg-brand-900/20 transition-colors"
          >
            {letter}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  {termsByLetter.map(({ letter, items }) => (
    <section id={`letter-${letter}`} class="scroll-mt-24">
      <h2 class="text-2xl font-bold border-b border-gray-200 dark:border-gray-700 pb-2">{letter}</h2>
      <dl class="mt-4 space-y-6">
        {items.map(item => (
          <div>
            <dt class="text-lg font-semibold text-gray-900 dark:text-white">{item.term}</dt>
            <dd class="mt-1 text-gray-600 dark:text-gray-400 leading-relaxed" set:html={item.definition} />
          </div>
        ))}
      </dl>
    </section>
  ))}

  <div class="not-prose mt-12 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800/50 p-6">
    <h2 class="text-lg font-bold text-gray-900 dark:text-white">Calculateurs connexes</h2>
    <ul class="mt-3 grid gap-2 sm:grid-cols-2 text-sm">
      <li><a href="/fr/" class="text-brand-600 hover:underline dark:text-brand-400">Calculateur de salaire net</a></li>
      <li><a href="/income-tax-calculator/" class="text-brand-600 hover:underline dark:text-brand-400">Calculateur d'impot sur le revenu</a></li>
      <li><a href="/cpp-calculator/" class="text-brand-600 hover:underline dark:text-brand-400">Calculateur de RPC</a></li>
      <li><a href="/ei-calculator/" class="text-brand-600 hover:underline dark:text-brand-400">Calculateur d'AE</a></li>
      <li><a href="/bonus-tax-calculator/" class="text-brand-600 hover:underline dark:text-brand-400">Calculateur d'impot sur les primes</a></li>
      <li><a href="/net-to-gross/" class="text-brand-600 hover:underline dark:text-brand-400">Calculateur net vers brut</a></li>
      <li><a href="/employer-cost-calculator/" class="text-brand-600 hover:underline dark:text-brand-400">Calculateur du cout employeur</a></li>
      <li><a href="/hourly-to-salary/" class="text-brand-600 hover:underline dark:text-brand-400">Calculateur horaire vers salaire</a></li>
    </ul>
  </div>
</GuideLayout>
