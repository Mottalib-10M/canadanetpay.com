  description="Salaires moyens et medians au Canada selon Statistique Canada. Revenus par province, industrie, groupe d'age et sexe avec estimations du salaire net."
  publishDate="2025-07-10"
  breadcrumbs={[{ label: 'Accueil', href: '/fr/' }, { label: 'Guides', href: '/fr/guides/' }, { label: 'Salaire moyen Canada' }]}
