        <tr><td>Territoires du Nord-Ouest</td><td>82 500 $</td><td>56 000 $</td></tr>
        <tr><td>Nouvelle-Ecosse</td><td>54 200 $</td><td>36 800 $</td></tr>
        <tr><td>Nunavut</td><td>78 300 $</td><td>52 400 $</td></tr>
