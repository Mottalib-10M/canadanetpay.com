---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import MiniSimAutonome from '../../components/calc/MiniSimAutonome';
import OasSources from '../../components/OasSources.astro';
import { formatCurrencyLang } from '../../lib/format';
import {
  PAYMENT_DATES_2026, OAS_QUARTER, OAS_VERIFIED, OAS_FULL_MONTHLY, OAS_75_PUBLISHED, GIS_SINGLE_MAX, GIS_COUPLE_MAX,
  ALLOWANCE_MAX, AFS_MAX, OAS_QUARTER_INCREASE, RECOVERY_YEARS,
} from '../../data/oas-2026';

const m = (x: number) => formatCurrencyLang(x, 'en', true);
const d = (x: number) => formatCurrencyLang(x, 'en');
const day = (iso: string) => new Date(iso + 'T12:00:00Z').toLocaleDateString('en-CA', { weekday: 'long', month: 'long', day: 'numeric', timeZone: 'UTC' });
const quarterOf = (iso: string) => ['January to March', 'April to June', 'July to September', 'October to December'][Math.floor((Number(iso.slice(5, 7)) - 1) / 3)];
const dates = PAYMENT_DATES_2026.map((iso) => ({ iso, label: day(iso), q: quarterOf(iso) }));
const dec = dates[11];
const rec25 = RECOVERY_YEARS.find((y) => y.incomeYear === 2025)!;

const faqs = [
  {
    question: 'When is the next OAS payment in 2026?',
    answer: `The remaining Old Age Security payments of 2026 arrive on ${dates[9].label}, ${dates[10].label} and ${dec.label}. CPP is paid on the same days. Each payment is for the month in which it arrives, and the amount is the one in force for ${OAS_QUARTER}. With direct deposit, the money is in the account on the payment date itself.`,
  },
  {
    question: 'Why is the December OAS payment early?',
    answer: `Payments normally fall in the last three banking days of the month, but December is brought forward to ${dec.label} so that the money arrives before the holidays. It is the December payment, not an advance on January: the January 2027 payment will still arrive at the end of January, so the gap between the two is longer than usual and worth planning for.`,
  },
  {
    question: 'How much is the OAS payment this month?',
    answer: `For ${OAS_QUARTER}, a full OAS pension is ${m(OAS_FULL_MONTHLY)} a month from 65 to 74 and ${m(OAS_75_PUBLISHED)} from 75. A partial pension is the fraction of years in Canada over 40. The amount actually deposited can be lower if income tax or recovery tax is withheld, and higher if the Guaranteed Income Supplement is paid, since it arrives in the same deposit.`,
  },
  {
    question: 'What should I do if my OAS payment has not arrived?',
    answer: 'Wait three working days after the scheduled date: a deposit can be delayed by the bank, and a cheque by the post. After that, contact Service Canada, which can trace or reissue the payment. Check first in My Service Canada Account that your banking details are current; a closed account is the most common reason a deposit fails.',
  },
  {
    question: 'Do OAS and GIS arrive on the same day?',
    answer: 'Yes. The OAS pension, the Guaranteed Income Supplement, the Allowance and the Allowance for the Survivor are all paid on the same dates as the Canada Pension Plan. The amounts of OAS and GIS are shown separately on the payment details in My Service Canada Account and on the T4A(OAS) slip at year end.',
  },
  {
    question: 'When does the OAS amount change?',
    answer: `In January, April, July and October, when the pension is adjusted to the Consumer Price Index; it never goes down. The October 2026 adjustment was ${(OAS_QUARTER_INCREASE * 100).toFixed(1)}%. The recovery tax deduction changes in July, when the income of the previous return takes over: from July 2026 it is based on 2025 income and the ${d(rec25.threshold)} threshold.`,
  },
];
---

<CalculatorLayout
  slug="/oas-payment-dates"
  title="OAS Payment Dates 2026"
  metaTitle="OAS Payment Dates 2026: Old Age Security Payment Calendar"
  metaDescription="OAS payment dates 2026 month by month, shared with CPP, the early December payment, and the OAS, GIS and Allowance amounts paid from October to December."
  h1="OAS Payment Dates 2026 and amounts"
  intro="The twelve days on which Old Age Security, the Guaranteed Income Supplement and CPP are paid in 2026, with the amount of each benefit this quarter."
  faqs={faqs}
  verified={OAS_VERIFIED}
  sourcesLine="Service Canada, ESDC"
>
  <div data-outil>
    <MiniSimAutonome client:visible kind="oas" lang="en" locale="en-CA" href="/oas-calculator/" />
  </div>

  <Fragment slot="content">
    <section class="mt-12 prose prose-gray dark:prose-invert max-w-none">
      <h2>2026 OAS and CPP payment calendar</h2>
      <div class="overflow-x-auto">
        <table>
          <thead><tr><th>Month</th><th>Payment date</th><th>Amount quarter</th></tr></thead>
          <tbody>
            {dates.map((x) => <tr><td>{new Date(x.iso + 'T12:00:00Z').toLocaleDateString('en-CA', { month: 'long', timeZone: 'UTC' })}</td><td>{x.label}</td><td>{x.q}</td></tr>)}
          </tbody>
        </table>
      </div>
      <p>
        Dates as published on the Employment and Social Development Canada calendar for 2026. The same days
        apply to the Canada Pension Plan, Old Age Security, the Guaranteed Income Supplement, the Allowance and the
        Allowance for the Survivor. Quebec residents receive their QPP pension from Retraite Québec on its own
        schedule, but their OAS and GIS follow this calendar.
      </p>

      <h2>Maximum amounts paid from October to December 2026</h2>
      <div class="overflow-x-auto">
        <table>
          <thead><tr><th>Benefit</th><th>Maximum per month</th></tr></thead>
          <tbody>
            <tr><td><a href="/oas-calculator/">OAS pension</a>, age 65 to 74</td><td>{m(OAS_FULL_MONTHLY)}</td></tr>
            <tr><td>OAS pension, age 75 and over</td><td>{m(OAS_75_PUBLISHED)}</td></tr>
            <tr><td><a href="/gis-calculator/">GIS</a>, single, widowed or divorced</td><td>{m(GIS_SINGLE_MAX)}</td></tr>
            <tr><td>GIS, each spouse when both receive OAS</td><td>{m(GIS_COUPLE_MAX)}</td></tr>
            <tr><td><a href="/allowance-calculator/">Allowance</a>, age 60 to 64</td><td>{m(ALLOWANCE_MAX)}</td></tr>
            <tr><td>Allowance for the Survivor, age 60 to 64</td><td>{m(AFS_MAX)}</td></tr>
          </tbody>
        </table>
      </div>

      <h2>How the payment dates are set</h2>
      <p>
        OAS is paid monthly, for the current month, in the last days of that month rather than on a fixed date.
        The day moves to avoid weekends and statutory holidays, which is why it ranges from the 25th to the 29th
        in 2026. December is the exception: the payment is brought forward to just before Christmas, on
        {' '}{dec.label} this year. Because CPP and OAS share the calendar, a pensioner who receives both sees
        two deposits on the same day, one from each program.
      </p>
      <p>
        Your first payment arrives in the month after your application is approved, or the month after your
        65th birthday if you were enrolled automatically, and covers that month. Back payments, when an
        application is late, are limited to the eleven months before the month Service Canada received it,
        on top of the current month.
      </p>

      <h2>What changes from one payment to the next</h2>
      <ul>
        <li><strong>Indexation, four times a year.</strong> The amounts change with the payments of January, April, July and October. The pension cannot fall, even when prices do.</li>
        <li><strong>The 75th birthday.</strong> The 10% increase starts with the payment for the month after the birthday.</li>
        <li><strong>July.</strong> The new payment period starts: GIS and the Allowance are recalculated on the previous year's income, and the recovery tax deduction is reset on the latest assessed return.</li>
        <li><strong>Tax withheld.</strong> Voluntary federal tax deductions, if you asked for them, stay the same until you change them.</li>
      </ul>
      <p>
        To check what your own payment should be, use the <a href="/oas-calculator/">OAS calculator</a>,
        the <a href="/gis-calculator/">GIS calculator</a> or, for all three public pensions together, the
        {' '}<a href="/cpp-oas-gis-calculator/">CPP + OAS + GIS calculator</a>. The amounts withheld from high
        incomes are explained on the <a href="/oas-clawback-calculator/">OAS clawback calculator</a>.
      </p>
    </section>
    <OasSources only={['dates', 'payments', 'gis', 'act']} />
  </Fragment>
</CalculatorLayout>
