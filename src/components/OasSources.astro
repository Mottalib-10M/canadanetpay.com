---
/**
 * Official sources of the Old Age Security pages, with the date each one was
 * read. Same role as OfficialSources.astro for the payroll pages: every
 * amount of the module can be traced to the organisation that sets it.
 * `only` restricts the list to the keys a page actually relies on.
 */
import { OAS_VERIFIED } from '../data/oas-2026';

interface Props { only?: string[] }
const { only } = Astro.props;

const all = [
  {
    key: 'payments',
    url: 'https://www.canada.ca/en/services/benefits/publicpensions/old-age-security/payments.html',
    nom: 'Service Canada, Old Age Security payment amounts',
    note: 'OAS, GIS, Allowance and Allowance for the Survivor: maximums and income limits for October to December 2026 (page modified 29 September 2026).',
  },
  {
    key: 'act',
    url: 'https://laws-lois.justice.gc.ca/eng/acts/o-9/',
    nom: 'Old Age Security Act, R.S.C. 1985, c. O-9',
    note: 'Residence rules, partial pension, deferral, the 75+ increase, the GIS and top-up formulas, the Allowance (consolidation current to 21 September 2026).',
  },
  {
    key: 'recovery',
    url: 'https://www.canada.ca/en/services/benefits/publicpensions/old-age-security/recovery-tax.html',
    nom: 'Service Canada, OAS pension recovery tax',
    note: '15 % rate and the thresholds for the 2024, 2025 and 2026 income years (page modified 29 September 2026).',
  },
  {
    key: 'cra',
    url: 'https://www.canada.ca/en/revenue-agency/services/tax/individuals/topics/about-your-tax-return/tax-return/completing-a-tax-return/deductions-credits-expenses/line-23500-social-benefits-repayment.html',
    nom: 'Canada Revenue Agency, line 23500 social benefits repayment',
    note: 'How the repayment is reported on the return and the T1213(OAS) request to reduce it at source.',
  },
  {
    key: 'gis',
    url: 'https://www.canada.ca/en/services/benefits/publicpensions/old-age-security/guaranteed-income-supplement.html',
    nom: 'Service Canada, Guaranteed Income Supplement',
    note: 'Who qualifies, automatic enrolment and the payment calendar.',
  },
  {
    key: 'estimator',
    url: 'https://estimateursv-oasestimator.digital.service.canada.ca/en',
    nom: 'Service Canada, Old Age Security Benefits Estimator',
    note: 'Top-up amounts and deferred pensions at 66 to 70 for the current quarter, used to check this calculator.',
  },
  {
    key: 'dates',
    url: 'https://www.canada.ca/content/dam/esdc-edsc/images/services/benefits/calendar/5564-calendar-2026-cpp-and-oas-en.pdf',
    nom: 'ESDC, 2026 CPP and OAS benefits payment dates',
    note: 'The twelve 2026 payment days, common to CPP and OAS.',
  },
];
const sources = only ? all.filter((s) => only.includes(s.key)) : all;
---

<section data-chrome class="mt-12 border-t border-border pt-8">
  <h2 class="text-2xl font-bold">Official sources</h2>
  <p class="mt-3 text-sm text-text-muted">
    Amounts are those Service Canada pays for October to December 2026, read on {OAS_VERIFIED}; the
    reduction formulas are applied as the Old Age Security Act writes them, roundings included.
  </p>
  <ul class="mt-4 space-y-3">
    {sources.map((s) => (
      <li>
        <a href={s.url} target="_blank" rel="noopener noreferrer" class="font-semibold text-primary no-underline hover:underline">{s.nom}</a>
        <p class="mt-0.5 text-sm text-text-muted">{s.note}</p>
      </li>
    ))}
  </ul>
</section>
