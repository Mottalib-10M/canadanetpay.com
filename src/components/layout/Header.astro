---
import { headerNav } from '../../data/nav';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;

const navItems = headerNav[lang] ?? headerNav.en;
const homeHref = lang === 'fr' ? '/fr/' : '/';
const siteName = lang === 'fr' ? 'Salaire Net Canada' : 'Salary After Tax';
const langSwitchLabel = lang === 'fr' ? 'EN' : 'FR';
const langSwitchHref = lang === 'fr' ? '/' : '/fr/';
const langSwitchMobileLabel = lang === 'fr' ? 'English version' : 'Version francaise';
---

<header class="sticky top-0 z-50 border-b border-gray-200 dark:border-gray-800 bg-white/95 dark:bg-gray-950/95 backdrop-blur-sm">
  <nav class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6" aria-label="Main navigation">
    <!-- Logo -->
    <a href={homeHref} class="flex items-center gap-2 font-bold text-brand-600 dark:text-brand-400 text-lg">
      <svg class="h-8 w-8" viewBox="0 0 32 32" fill="none">
        <rect width="32" height="32" rx="6" fill="currentColor"/>
        <text x="16" y="22" font-family="system-ui" font-weight="700" font-size="18" fill="white" text-anchor="middle">$</text>
      </svg>
      <span class="hidden sm:inline">{siteName}</span>
    </a>

    <!-- Desktop nav -->
    <div class="hidden lg:flex items-center gap-1">
      {navItems.map((item) => (
        <div class="relative group">
          <button class="px-3 py-2 text-sm font-medium text-gray-700 dark:text-gray-300 hover:text-brand-600 dark:hover:text-brand-400 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors" aria-expanded="false">
            {item.label}
            <svg class="inline-block ml-1 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M19 9l-7 7-7-7"/></svg>
          </button>
          <div class="absolute left-0 top-full pt-1 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150">
            <div class="w-64 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-dark-surface shadow-lg py-2">
              {item.children.map((child) => (
                <a href={child.href} class="block px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-brand-50 dark:hover:bg-brand-900/20 hover:text-brand-600 dark:hover:text-brand-400 transition-colors">
                  {child.label}
                </a>
              ))}
            </div>
          </div>
        </div>
      ))}

      <!-- Language switch -->
      <a href={langSwitchHref} class="ml-2 px-3 py-2 text-sm font-medium text-gray-500 dark:text-gray-400 hover:text-brand-600 dark:hover:text-brand-400 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">
        {langSwitchLabel}
      </a>
    </div>

    <!-- Mobile menu button -->
    <button id="mobile-menu-btn" class="lg:hidden p-2 rounded-lg text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800" aria-label="Toggle menu" aria-expanded="false">
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 px-4 py-4">
    {navItems.map((item) => (
      <details class="mb-2">
        <summary class="flex cursor-pointer items-center justify-between py-2 font-medium text-gray-900 dark:text-white">
          {item.label}
          <svg class="h-5 w-5 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M12 6v12M6 12h12"/></svg>
        </summary>
        <div class="pl-4 pb-2">
          {item.children.map((child) => (
            <a href={child.href} class="block py-1.5 text-sm text-gray-600 dark:text-gray-400 hover:text-brand-600 dark:hover:text-brand-400">
              {child.label}
            </a>
          ))}
        </div>
      </details>
    ))}
    <a href={langSwitchHref} class="block py-2 text-sm font-medium text-gray-500 dark:text-gray-400">{langSwitchMobileLabel}</a>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const expanded = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!expanded));
    menu?.classList.toggle('hidden');
  });
</script>
