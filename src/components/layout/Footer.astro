---
import {
  footerCalcLinksEn,
  footerProvinceLinksEn,
  footerGuideLinksEn,
  footerAboutLinksEn,
} from '../../data/nav';

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-950">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
    <nav aria-label="Footer navigation">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      <!-- Calculators -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-900 dark:text-white">Calculators</h3>
        <ul class="mt-3 space-y-2">
          {footerCalcLinksEn.map((link) => (
            <li><a href={link.href} class="text-sm text-gray-600 dark:text-gray-400 hover:text-brand-600 dark:hover:text-brand-400">{link.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Popular Provinces -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-900 dark:text-white">Popular Provinces</h3>
        <ul class="mt-3 space-y-2">
          {footerProvinceLinksEn.map((link) => (
            <li><a href={link.href} class="text-sm text-gray-600 dark:text-gray-400 hover:text-brand-600 dark:hover:text-brand-400">{link.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Guides -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-900 dark:text-white">Guides</h3>
        <ul class="mt-3 space-y-2">
          {footerGuideLinksEn.map((link) => (
            <li><a href={link.href} class="text-sm text-gray-600 dark:text-gray-400 hover:text-brand-600 dark:hover:text-brand-400">{link.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- About -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-900 dark:text-white">About</h3>
        <ul class="mt-3 space-y-2">
          {footerAboutLinksEn.map((link) => (
            <li><a href={link.href} class="text-sm text-gray-600 dark:text-gray-400 hover:text-brand-600 dark:hover:text-brand-400">{link.label}</a></li>
          ))}
        </ul>
      </div>
    </div>
    </nav>

    <!-- Trust bar -->
    <div class="mt-10 flex flex-wrap items-center justify-center gap-4 text-xs text-gray-500 dark:text-gray-400">
      <span>CRA 2025 data</span>
      <span>&middot;</span>
      <span>100% calculated in your browser</span>
      <span>&middot;</span>
      <span>Free &amp; private</span>
    </div>

    <!-- Disclaimer -->
    <p class="mt-4 text-center text-xs text-gray-400 dark:text-gray-500">
      This calculator provides estimates for informational purposes only. It is not tax advice.
      Consult a qualified tax professional for personalized guidance. Results may differ from your actual tax liability.
      Sources: Canada Revenue Agency (CRA), Revenu Qu&eacute;bec.
    </p>

    <!-- Copyright -->
    <p class="mt-6 text-center text-xs text-gray-400 dark:text-gray-500">
      &copy; {currentYear} Salary After Tax Canada. All rights reserved.
    </p>
  </div>
</footer>
