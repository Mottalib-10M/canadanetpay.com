---
interface Props {
  publishDate: string;
  modifiedDate?: string;
}

const { publishDate, modifiedDate } = Astro.props;

function formatDate(iso: string): string {
  return new Date(iso).toLocaleDateString('en-CA', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<div class="flex items-center gap-4 mt-4 pt-4 border-t border-gray-200 dark:border-gray-700">
  <img
    src="/team/mottalib-radif.jpg"
    alt="Mottalib Radif"
    class="flex-shrink-0 h-10 w-10 rounded-full object-cover"
    width="40"
    height="40"
    loading="lazy"
  />
  <div class="text-sm text-gray-600 dark:text-gray-400">
    <p class="font-medium text-gray-900 dark:text-white">Mottalib Radif, MBA</p>
    <p>
      Published {formatDate(publishDate)}
      {modifiedDate && modifiedDate !== publishDate && (
        <span> · Updated {formatDate(modifiedDate)}</span>
      )}
    </p>
  </div>
</div>
