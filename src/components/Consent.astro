---
/**
 * Mesure technique de la stabilité du site avec Microsoft Clarity, en mode SANS COOKIE
 * (décision de l'éditeur du 2026-10-06, RECETTE-SITE.md §15.6).
 *
 * Deux emplacements, un seul composant :
 *  - part="head" : met en file le signal consentv2 { ad_Storage: denied, analytics_Storage: denied }
 *    AVANT d'insérer le script Clarity. Clarity tourne alors sans aucun cookie (_clck, _clsk, MUID,
 *    CLID), avec un identifiant par page vue, sans relier les visites ; le contenu est masqué par
 *    `data-clarity-mask="true"` sur le <body> du layout.
 *  - part="body" : ne rend plus rien (aucun bandeau, aucun lien « gérer les cookies ») ; conservé
 *    pour ne pas toucher aux appels existants.
 *
 * Aucun GA4 ni autre traceur. Rien n'est rendu si CLARITY_ID est vide ou si CONSENT_MODE n'est pas
 * 'none'. Les pages /embed/ n'utilisent pas ce composant : un widget intégré chez un tiers ne mesure rien.
 */
import { CLARITY_ID, CONSENT_MODE } from '../data/site-config';

interface Props { part: 'head' | 'body'; lang?: string; moreHref?: string }
const { part } = Astro.props;
---
{CLARITY_ID && CONSENT_MODE === 'none' && part === 'head' && (
  <script is:inline set:html={`(function(){window.clarity=window.clarity||function(){(window.clarity.q=window.clarity.q||[]).push(arguments);};window.clarity('consentv2',{ad_Storage:'denied',analytics_Storage:'denied'});var s=document.createElement('script');s.async=true;s.src='https://www.clarity.ms/tag/${CLARITY_ID}';document.head.appendChild(s);})();`} />
)}
